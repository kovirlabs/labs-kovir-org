---
import { formatUpdated, loadSnapshot } from '../lib/snapshot.ts';

const year = new Date().getFullYear();
const { fetchedAt } = loadSnapshot();
const updated = formatUpdated(fetchedAt);
---

<footer>
  <p>
    Kovir Labs is the development arm of <a href="https://www.kovir.org">Kovir LLC</a>, which helps
    mission-driven organizations build capacity and increase impact.
  </p>
  <nav aria-label="Kovir Labs">
    <h2>Kovir Labs</h2>
    <ul>
      <li><a href="/projects">Projects</a></li>
      <li><a href="/ideas">Ideas</a></li>
      <li><a href="/about">About</a></li>
      <li><a href="/contact">Contact</a></li>
      <li><a href="/privacy">Privacy</a></li>
    </ul>
  </nav>
  <nav aria-label="Community">
    <h2>Community</h2>
    <ul>
      <li><a href="https://github.com/kovirlabs">GitHub</a></li>
      <li><a href="https://github.com/kovirlabs/community/discussions">Community forum</a></li>
      <li><a href="mailto:info@kovir.org">info@kovir.org</a></li>
    </ul>
  </nav>
  <p>© {year} Kovir LLC · <a href="https://www.kovir.org">kovir.org</a></p>
  {updated && fetchedAt && <p>Project data updated <time datetime={fetchedAt}>{updated}</time></p>}
</footer>
