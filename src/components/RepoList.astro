---
// Every public org repo as a table. TagAction sorts it by any column and filters its rows as
// you type in the search box (aria-controls). Dates are date-only so TagAction shows a day,
// not a clock time.
import type { RepoRow } from '../lib/all-repos.ts';

interface Props { rows: RepoRow[] }
const { rows } = Astro.props;
---

<search>
  <input type="search" aria-label="Filter repositories" aria-controls="repo-table" placeholder="Filter repositories" />
</search>
<table id="repo-table">
  <thead>
    <tr><th>Repository</th><th>Description</th><th>Language</th><th>Updated</th><th>Status</th></tr>
  </thead>
  <tbody>
    {
      rows.map((r) => (
        <tr>
          <td><a href={r.url}>{r.name}</a>{r.fork && <small> (fork)</small>}</td>
          <td>{r.description ?? ''}</td>
          <td>{r.language ?? ''}</td>
          <td><time datetime={r.updatedIso.slice(0, 10)}>{r.updated}</time></td>
          <td>
            {r.projectHref ? (
              <mark data-tone="success"><a href={r.projectHref}>Project page</a></mark>
            ) : (
              <mark data-tone="neutral">Not reviewed</mark>
            )}
          </td>
        </tr>
      ))
    }
  </tbody>
</table>
