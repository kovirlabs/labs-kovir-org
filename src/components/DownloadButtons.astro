---
import type { ProjectView } from '../lib/projects.ts';

interface Props { view: ProjectView }
const { view } = Astro.props;
const primary = view.downloads.filter((d) => d.primary);
const other = view.downloads.filter((d) => !d.primary);
---

{
  primary.length > 0 ? (
    <>
      <div role="group">
        {primary.map((d, i) => (
          <a class={i === 0 ? 'button' : 'button secondary'} href={d.url}>
            {d.label}
          </a>
        ))}
      </div>
      {other.length > 0 && (
        <details>
          <summary>Other downloads</summary>
          <ul>
            {other.map((d) => (
              <li><a href={d.url}>{d.label}</a></li>
            ))}
          </ul>
        </details>
      )}
      {view.release && (
        <p><small>{view.release.tag} from <a href={view.release.url}>GitHub Releases</a>.</small></p>
      )}
    </>
  ) : (
    <div role="group">
      <a class="button" href={view.primaryAction.url}>{view.primaryAction.label}</a>
      {view.primaryAction.kind !== 'repo' && <a class="button secondary" href={view.repoUrl}>View on GitHub</a>}
    </div>
  )
}
