---
// The top bar's <nav>; TagBrush lays it out as a row and Base.astro supplies the <header>.
// The link for the current section is marked at build time, so /projects/<slug> marks
// Projects and the mark works without JavaScript; TagAction leaves pre-marked links alone.
const path = Astro.url.pathname;
const current = (href: string) => (path === href || path.startsWith(`${href}/`) ? 'page' : undefined);
---

<nav aria-label="Primary">
  <a href="/" aria-label="Kovir Labs — home">
    <picture>
      <source srcset="/logo-labs-light.svg" media="(prefers-color-scheme: light)" />
      <img src="/logo-labs-dark.svg" alt="Kovir Labs" width="190" height="37" />
    </picture>
  </a>
  <ul>
    <li><a href="/projects" aria-current={current('/projects')}>Projects</a></li>
    <li><a href="/ideas" aria-current={current('/ideas')}>Ideas</a></li>
    <li><a href="/about" aria-current={current('/about')}>About</a></li>
    <li><a class="button" href="/contact" aria-current={current('/contact')}>Contact</a></li>
  </ul>
</nav>
