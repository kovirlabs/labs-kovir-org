---
// Ideas as a table: TagAction sorts it by any column. Upvotes and comments carry <data value>
// so they sort as numbers; the status badge comes from src/lib/tones.ts.
import type { IdeaView } from '../lib/ideas.ts';
import { ideaTone } from '../lib/tones.ts';

interface Props { ideas: IdeaView[]; empty: string }
const { ideas, empty } = Astro.props;
---

{
  ideas.length === 0 ? (
    empty && <p>{empty}</p>
  ) : (
    <table>
      <thead>
        <tr><th>Idea</th><th>Upvotes</th><th>Comments</th><th>Status</th></tr>
      </thead>
      <tbody>
        {ideas.map((idea) => {
          const badge = ideaTone(idea.status);
          return (
            <tr>
              <td><a href={idea.url}>{idea.title}</a></td>
              <td><data value={idea.upvotes}>{idea.upvotes}</data></td>
              <td><data value={idea.comments}>{idea.comments}</data></td>
              <td><mark data-tone={badge.tone}>{badge.label}</mark></td>
            </tr>
          );
        })}
      </tbody>
    </table>
  )
}
