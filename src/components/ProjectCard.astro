---
// One project as a TagBrush card: an <article> inside a <section> of articles becomes a grid
// cell. The title link covers the whole card (kovir.css). data-category and data-platforms
// feed the /projects filter in site.ts.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { PLATFORM_LABEL } from '../lib/labels.ts';
import type { ProjectView } from '../lib/projects.ts';
import { releaseLine, supportTone } from '../lib/tones.ts';

interface Props { view: ProjectView; icon?: ImageMetadata; compact?: boolean }
const { view, icon, compact = false } = Astro.props;
const badge = supportTone(view.support);
const release = releaseLine(view.release);
const platforms = view.platforms.map((p) => PLATFORM_LABEL[p]).join(' · ');
---

<article data-category={view.category} data-platforms={view.platforms.join(' ')}>
  <header>
    {icon ? <Image src={icon} alt="" width={56} height={56} /> : <span aria-hidden="true">{view.name.charAt(0)}</span>}
    <h3><a href={`/projects/${view.slug}`}>{view.name}</a></h3>
  </header>
  <p>{view.tagline}</p>
  <p><mark data-tone={badge.tone}>{badge.label}</mark></p>
  {!compact && <p>For: {view.audience}</p>}
  <footer>
    <p>
      {
        release ? (
          <>
            <data value={release.tag}>{release.tag}</data> · <time datetime={release.iso.slice(0, 10)}>{release.date}</time>
          </>
        ) : (
          'No release yet'
        )
      }
      {platforms && <> · {platforms}</>}
    </p>
  </footer>
</article>
