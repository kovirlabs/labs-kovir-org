---
import Base from '../layouts/Base.astro';
import IdeaList from '../components/IdeaList.astro';
import { groupIdeas, toIdeaViews } from '../lib/ideas.ts';
import { loadSnapshot } from '../lib/snapshot.ts';
import { FORUM_REPO } from '../lib/github-query.ts';

const g = groupIdeas(toIdeaViews(loadSnapshot().ideas));
const forum = `https://github.com/${FORUM_REPO}/discussions`;
---

<Base title="Ideas" description="Suggest software that would help mission-driven organizations. The kovir.org team decides what Kovir Labs takes on.">
  <section class="section container">
    <h1>Ideas</h1>
    <div class="prose">
      <p class="lede">
        Anyone can suggest software that would help mission-driven organizations. Kovir Labs builds tools
        that many organizations can use, so the best ideas describe a need others share.
      </p>
      <p>
        Upvotes and comments show how widely a need is felt. The kovir.org team reviews ideas regularly and
        decides which ones Kovir Labs takes on. Being accepted is a commitment. It is not a delivery date.
      </p>
    </div>
    <div class="btn-row">
      <a class="btn" href={`${forum}/new?category=ideas`}>Post on the forum</a>
      <a class="btn btn-ghost" href="/contact?type=idea">No GitHub account? Use the form</a>
    </div>
    <p class="muted small">
      The forum is hosted on GitHub, under GitHub's <a href="https://docs.github.com/site-policy/github-terms/github-terms-of-service">terms</a>
      and <a href="https://docs.github.com/site-policy/privacy-policies/github-general-privacy-statement">privacy statement</a>.
      Posting or voting needs a free GitHub account.
    </p>
  </section>

  <section class="container board">
    <section aria-labelledby="active">
      <h2 id="active">Accepted and in progress</h2>
      <IdeaList ideas={g.active} empty="Nothing accepted yet." />
    </section>
    <section aria-labelledby="review">
      <h2 id="review">Under review</h2>
      <IdeaList ideas={g.underReview} empty="No ideas waiting for review. Suggest one." />
    </section>
    <section aria-labelledby="shipped">
      <h2 id="shipped">Shipped</h2>
      <IdeaList ideas={g.shipped} empty="Nothing shipped from the idea board yet." />
    </section>
    {
      g.notNow.length > 0 && (
        <details>
          <summary>Not right now ({g.notNow.length})</summary>
          <p class="muted">Ideas the team decided not to take on for now. Each one has a short reason on the forum.</p>
          <IdeaList ideas={g.notNow} empty="" />
        </details>
      )
    }
  </section>
</Base>

<style>
  .prose { margin-bottom: 1.5rem; }
  .small { font-size: 0.875rem; margin-top: 1rem; }
  .board { display: grid; gap: 2.5rem; padding-bottom: 3rem; }
  summary { cursor: pointer; font: 700 1.1rem/1.3 var(--font-head); }
</style>
