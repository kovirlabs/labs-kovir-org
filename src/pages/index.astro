---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import IdeaList from '../components/IdeaList.astro';
import KovirBand from '../components/KovirBand.astro';
import { getProjects } from '../lib/project-data.ts';
import { groupBySupport } from '../lib/projects.ts';
import { toIdeaViews, topIdeas } from '../lib/ideas.ts';
import { loadSnapshot } from '../lib/snapshot.ts';

const projects = await getProjects();
const iconFor = new Map(projects.map((p) => [p.view.slug, p.entry.data.icon]));
const groups = groupBySupport(projects.map((p) => p.view));
const fromTheLab = [...groups.incubating, ...groups.lab];
const top = topIdeas(toIdeaViews(loadSnapshot().ideas), 3);
---

<Base title="Kovir Labs">
  <Fragment slot="hero">
    <hgroup>
      <p>Kovir Labs · the development arm of Kovir LLC</p>
      <h1>Open software for mission-driven work. <em>Built once, useful to many organizations.</em></h1>
      <p>
        We build tools that many mission-driven organizations can use, not custom software for one.
        Anyone can suggest an idea. The kovir.org team decides what we take on.
      </p>
    </hgroup>
    <div role="group">
      <a class="button" href="/projects">Browse projects</a>
      <a class="button outline" href="/ideas">Suggest an idea</a>
    </div>
  </Fragment>
  {
    groups.featured.length > 0 && (
      <section id="featured" aria-labelledby="featured-title">
        <h2 id="featured-title">Officially supported</h2>
        {groups.featured.map((v) => (
          <ProjectCard view={v} icon={iconFor.get(v.slug)} />
        ))}
      </section>
    )
  }
  {
    fromTheLab.length > 0 && (
      <section id="from-the-lab" aria-labelledby="lab-title">
        <h2 id="lab-title">From the lab</h2>
        <p>Projects in progress or under evaluation. Each page says how mature it is.</p>
        {fromTheLab.map((v) => (
          <ProjectCard view={v} icon={iconFor.get(v.slug)} compact />
        ))}
      </section>
    )
  }
  <section id="how-it-works" aria-labelledby="how-title">
    <h2 id="how-title">How ideas become software</h2>
    <article>
      <hgroup><p>1</p><h3>Suggest</h3></hgroup>
      <p>Anyone can post a need on the <a href="/ideas">community forum</a> or through the <a href="/contact?type=idea">contact form</a>. Upvotes and comments show how widely it's felt.</p>
    </article>
    <article>
      <hgroup><p>2</p><h3>Kovir decides</h3></hgroup>
      <p>The kovir.org team reviews ideas and chooses what Kovir Labs adopts, favoring needs many organizations share. <a href="/about">How decisions are made</a>.</p>
    </article>
    <article>
      <hgroup><p>3</p><h3>Labs builds and supports</h3></hgroup>
      <p>Accepted ideas become open-source tools, maintained by Kovir Labs and free for every organization to use.</p>
    </article>
  </section>
  <section aria-labelledby="ideas-title">
    <header>
      <h2 id="ideas-title">Top ideas right now</h2>
      <a href="/ideas">All ideas</a>
    </header>
    <IdeaList ideas={top} empty="No ideas yet. Be the first to suggest one." />
  </section>
  <KovirBand />
</Base>
