---
// Netlify Forms redirects here after a successful submission (the form's action).
import Base from '../../layouts/Base.astro';
---

<Base title="Thank you" description="Your message reached the Kovir team." noindex>
  <section class="section container">
    <h1>Thank you!</h1>
    <p class="lede">Your message reached the Kovir team. We'll reply by email, usually within a few working days.</p>
    <div class="btn-row">
      <a class="btn" href="/ideas">See community ideas</a>
      <a class="btn btn-ghost" href="/projects">Browse projects</a>
    </div>
  </section>
</Base>
