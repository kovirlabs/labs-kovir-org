---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import DownloadButtons from '../../components/DownloadButtons.astro';
import { getProjects, type Project } from '../../lib/project-data.ts';
import { CATEGORY_LABEL, PLATFORM_LABEL, STATUS_LABEL } from '../../lib/labels.ts';
import { FORUM_REPO } from '../../lib/github-query.ts';
import { releaseLine, supportTone } from '../../lib/tones.ts';

export async function getStaticPaths() {
  return (await getProjects()).map((p) => ({ params: { slug: p.view.slug }, props: p }));
}

const { view, entry } = Astro.props as Project;
const { icon, screenshots } = entry.data;
const { Content } = await render(entry);
const forum = `https://github.com/${FORUM_REPO}/discussions`;
const supportNote = {
  official: 'The kovir.org team has adopted this project. Kovir Labs supports and maintains it.',
  incubating: 'Being evaluated by the kovir.org team. There is no support promise yet.',
  lab: 'An experiment from the lab. Use it, enjoy it, and expect rough edges.',
}[view.support];
const badge = supportTone(view.support);
const release = releaseLine(view.release);
const platformText = view.platforms.map((p) => PLATFORM_LABEL[p]).join(' · ');
const os = view.platforms.filter((p) => ['windows', 'macos', 'linux'].includes(p)).map((p) => PLATFORM_LABEL[p]);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: view.name,
  description: view.tagline,
  applicationCategory: view.category === 'education' ? 'EducationalApplication' : 'DeveloperApplication',
  ...(os.length ? { operatingSystem: os.join(', ') } : {}),
  ...(view.release ? { softwareVersion: view.release.tag.replace(/^v/, '') } : {}),
  ...(view.license ? { license: `https://spdx.org/licenses/${view.license}.html` } : {}),
  url: new URL(`/projects/${view.slug}`, Astro.site).href,
  codeRepository: view.repoUrl,
  publisher: { '@type': 'Organization', name: 'Kovir LLC', url: 'https://www.kovir.org' },
};
---

<Base title={view.name} description={view.tagline} ogImage={screenshots[0]?.src} jsonLd={jsonLd}>
  <nav aria-label="Breadcrumb">
    <ol>
      <li><a href="/projects">Projects</a></li>
      <li><a aria-current="page">{view.name}</a></li>
    </ol>
  </nav>
  <article id="project">
    <header>
      {icon && <Image src={icon} alt="" width={88} height={88} loading="eager" />}
      <hgroup>
        <h1>{view.name}</h1>
        <p>{view.tagline}</p>
      </hgroup>
    </header>
    <p>
      <mark data-tone={badge.tone}>{badge.label}</mark>
      <mark data-tone="neutral">{STATUS_LABEL[view.status]}</mark>
      {
        release && view.release ? (
          <>
            <a href={view.release.url}><data value={release.tag}>{release.tag}</data></a>, released{' '}
            <time datetime={release.iso} data-tag-time="relative">{release.date}</time>
          </>
        ) : (
          'No release yet. Build from source.'
        )
      }
      {view.license && <> · {view.license}</>}
      {view.stars !== null && view.stars > 0 && <> · ★ {view.stars}</>}
    </p>
    <DownloadButtons view={view} />

    {
      screenshots.map((s, i) => (
        <figure>
          <a href={s.src.src}>
            <Image src={s.src} alt={s.alt} widths={[640, 1100, 1600]} sizes="(min-width: 72rem) 70rem, 100vw" loading={i === 0 ? 'eager' : 'lazy'} />
          </a>
        </figure>
      ))
    }

    <Content />

    <section aria-labelledby="facts">
      <h2 id="facts">Project facts</h2>
      <dl>
        <dt>Support</dt><dd>{supportNote}</dd>
        <dt>Who it's for</dt><dd>{view.audience}</dd>
        <dt>Category</dt><dd>{CATEGORY_LABEL[view.category]}</dd>
        <dt>Platforms</dt><dd>{platformText}</dd>
        {view.license && (<><dt>License</dt><dd><code>{view.license}</code></dd></>)}
        <dt>Source</dt><dd><a href={view.repoUrl}>{view.repo}</a></dd>
        {view.website && (<><dt>Website</dt><dd><a href={view.website}>{new URL(view.website).host}</a></dd></>)}
        {view.docs && (<><dt>Docs</dt><dd><a href={view.docs}>User guide</a></dd></>)}
        {view.forkOf && (<><dt>Credit</dt><dd>Continuation of <a href={`https://github.com/${view.forkOf}`}>{view.forkOf}</a></dd></>)}
        {view.topics.length > 0 && (<><dt>Topics</dt><dd>{view.topics.join(' · ')}</dd></>)}
      </dl>
    </section>
  </article>

  <section id="get-involved" aria-labelledby="involved">
    <h2 id="involved">Get involved</h2>
    <div role="group">
      <a class="button outline" href={`/contact?type=idea&project=${view.slug}`}>Request a feature</a>
      <a class="button outline" href={`${view.repoUrl}/issues`}>Report a bug on GitHub</a>
      <a class="button outline" href="/ideas">Browse community ideas</a>
    </div>
    <ul>
      {view.community?.contributing && <li><a href={`${view.repoUrl}/blob/HEAD/CONTRIBUTING.md`}>Contributing guide</a></li>}
      {view.community?.codeOfConduct && <li><a href={`${view.repoUrl}/blob/HEAD/CODE_OF_CONDUCT.md`}>Code of conduct</a></li>}
      {view.community?.securityPolicy && <li><a href={`${view.repoUrl}/security/policy`}>Security policy</a></li>}
    </ul>
    {
      view.ideas.length > 0 && (
        <>
          <h3>Related ideas</h3>
          <ul>
            {view.ideas.map((n) => (
              <li><a href={`${forum}/${n}`}>Idea #{n} on the forum</a></li>
            ))}
          </ul>
        </>
      )
    }
  </section>
</Base>
