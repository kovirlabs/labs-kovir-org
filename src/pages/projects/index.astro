---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import RepoList from '../../components/RepoList.astro';
import { toRepoRows } from '../../lib/all-repos.ts';
import { INFRA_REPOS } from '../../lib/catalog.ts';
import { loadSnapshot } from '../../lib/snapshot.ts';
import { getProjects } from '../../lib/project-data.ts';
import { CATEGORY_LABEL, PLATFORM_LABEL } from '../../lib/labels.ts';
import type { Support } from '../../lib/project-rules.ts';

const projects = await getProjects();
const sections: { support: Support; title: string; note: string }[] = [
  { support: 'official', title: 'Officially supported', note: 'Adopted by the kovir.org team and maintained by Kovir Labs.' },
  { support: 'incubating', title: 'Incubating', note: 'Being evaluated by the kovir.org team. No support promise yet.' },
  { support: 'lab', title: 'From the lab', note: 'Experiments and side projects. Useful, honest about their rough edges.' },
];
const categories = [...new Set(projects.map((p) => p.view.category))];
const platforms = [...new Set(projects.flatMap((p) => p.view.platforms))];
const curated = Object.fromEntries(projects.map((p) => [p.view.repo, p.view.slug]));
const repoRows = toRepoRows(loadSnapshot().publicRepos, curated, INFRA_REPOS);
---

<Base title="Projects" description="Open software from Kovir Labs, grouped by how Kovir supports it.">
  <hgroup>
    <h1>Projects</h1>
    <p>
      Everything Kovir Labs builds is open source on <a href="https://github.com/kovirlabs">GitHub</a>.
      Projects are grouped by how much support Kovir commits to them.
    </p>
  </hgroup>

  <search id="project-filter" hidden>
    <label for="filter-category">Category</label>
    <select id="filter-category" name="category">
      <option value="">All categories</option>
      {categories.map((c) => <option value={c}>{CATEGORY_LABEL[c]}</option>)}
    </select>
    <label for="filter-platform">Platform</label>
    <select id="filter-platform" name="platform">
      <option value="">All platforms</option>
      {platforms.map((p) => <option value={p}>{PLATFORM_LABEL[p]}</option>)}
    </select>
    <output for="filter-category filter-platform" aria-live="polite"></output>
  </search>

  {
    sections.map((s) => {
      const list = projects.filter((p) => p.view.support === s.support);
      return (
        list.length > 0 && (
          <section aria-labelledby={`group-${s.support}`}>
            <h2 id={`group-${s.support}`}>{s.title}</h2>
            <p>{s.note}</p>
            {list.map((p) => (
              <ProjectCard view={p.view} icon={p.entry.data.icon} />
            ))}
          </section>
        )
      );
    })
  }
  <p id="no-match" hidden>No projects match those filters.</p>

  {
    repoRows.length > 0 && (
      <section id="all-repositories" aria-labelledby="all-repos">
        <h2 id="all-repos">All repositories</h2>
        <p>
          Every public repository in the <a href="https://github.com/kovirlabs">kovirlabs</a> GitHub
          organization. Repositories without a project page haven't been reviewed by the Kovir team.
        </p>
        <RepoList rows={repoRows} />
      </section>
    )
  }
</Base>

<script>
  import '../../scripts/site.ts';
</script>
