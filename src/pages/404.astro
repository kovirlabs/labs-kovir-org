---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <article>
    <hgroup>
      <p>404</p>
      <h1>That page isn't here.</h1>
      <p>It may have moved, or the link may be mistyped.</p>
    </hgroup>
    <div role="group">
      <a class="button" href="/projects">Browse projects</a>
      <a class="button outline" href="/ideas">See ideas</a>
    </div>
  </article>
</Base>
